    },
    "neon": {
      "enabled": false,
      "color": "#22D3EE",
      "intensity": 0.8
    },
    "animation": {
      "type": "fadeIn",
      "duration": 350,
      "delay": 0
    },
    "hoverScale": 1,
    "idleAnim": {
      "enabled": true,
      "type": "none",
      "amplitude": 6,
      "duration": 3200
    },
    "dots": {
      "color": "#F8FAFC",
      "size": 6,
      "spacing": 6,
      "animation": "bounce"
    },
    "badge": {
      "position": "top-right",
      "offsetX": -6,          
      "offsetY": -6,          
      "size": 20,              
      "fontSize": 11,          
      "backgroundColor": "#dc2626",
      "textColor": "#ffffff",
      "borderWidth": 2,
      "borderColor": "#ffffff"
    }
  },

