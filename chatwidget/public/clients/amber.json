    "backgroundColor": "#1E40AF",
    "gradientType": "linear",
    "gradientAngle": 135,
    "gradientStops": [
      {
        "color": "#1E40AF",
        "pos": 0
      },
      {
        "color": "#9333EA",
        "pos": 100
