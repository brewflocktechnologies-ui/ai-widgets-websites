  "//_bubble_section": "--- FLOATING BUBBLE TRIGGER BUTTON ---",

  "bubble": {
    "useWebsiteTheme": true,
    "width": 60,
    "height": 60,
    "borderRadius": {
      "tl": 50,
      "tr": 50,
      "bl": 50,
      "br": 50
